# ── Database ──────────────────────────────────────────────────────────────────
# Sync psycopg2 driver — used by docker-compose and direct local runs.
# docker-compose overrides DATABASE_URL automatically; set it here for local dev.
DATABASE_URL=postgresql+psycopg2://iot:changeme@localhost:5432/iot_db

# ── PostgreSQL (docker-compose only) ─────────────────────────────────────────
# docker-compose reads POSTGRES_PASSWORD to configure the postgres container
# and to build the DATABASE_URL override for the api service.
POSTGRES_PASSWORD=changeme

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=IoT Backend
# Set to False in production. In debug mode the secret-key guard is bypassed.
DEBUG=False

# ── CORS ───────────────────────────────────────────────────────────────────────
# JSON list of allowed origins. Default is ["*"] (permissive). Tighten in production.
# CORS_ORIGINS=["https://app.example.com", "https://admin.example.com"]

# ── Security ───────────────────────────────────────────────────────────────────
# REQUIRED in production (DEBUG=False). Must not equal the default value.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ── Session — Valkey/Redis ────────────────────────────────────────────────────
# docker-compose overrides VALKEY_URL automatically; keep this for local dev.
VALKEY_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# ── Session — Encryption ──────────────────────────────────────────────────────
# REQUIRED in production (DEBUG=False). Must not equal the default value.
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=change-me-32-byte-base64-key-here

# ── Authentication method by entity type ──────────────────────────────────────
# Allowed values: auth_rc | auth_xmss
AUTH_ADMINISTRATOR_METHOD=auth_rc
AUTH_MANAGER_METHOD=auth_rc
AUTH_USER_METHOD=auth_rc
AUTH_DEVICE_METHOD=auth_rc
AUTH_APPLICATION_METHOD=auth_rc
