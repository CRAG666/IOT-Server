### List users
# @expect 200
GET /api/v1/users/

### Create user
# CURP SOLA850315MDFXYZ07 — valid check digit (female, CDMX)
# @expect 201
# @capture new_user_id $.id
# @assert $.first_name E2EUser
# @assert $.is_active true
POST /api/v1/users/

{
  "first_name": "E2EUser",
  "last_name": "Test",
  "second_last_name": "Suite",
  "phone": "+523312345682",
  "address": "300 Integration Test Ave",
  "city": "Monterrey",
  "state": "Nuevo Leon",
  "postal_code": "64000",
  "birth_date": "1992-11-05T00:00:00",
  "email": "e2e.user@iotmx.test",
  "password": "E2eUser01!",
  "curp": "SOLA850315MDFXYZ07",
  "rfc": "SOLA850315AB1"
}

### Get user by ID
# @expect 200
# @assert $.id {{new_user_id}}
# @assert $.first_name E2EUser
GET /api/v1/users/{{new_user_id}}

### Update user phone
# @expect 200
PATCH /api/v1/users/{{new_user_id}}

{"phone": "+523312345699"}

### Restore phone
# @expect 200
PATCH /api/v1/users/{{new_user_id}}

{"phone": "+523312345682"}

### List user roles — empty initially
# @expect 200
GET /api/v1/users/{{new_user_id}}/roles

### Get non-existent user — 404
# @expect 404
GET /api/v1/users/00000000-0000-0000-0000-000000000002

### Deactivate user
# @expect 200
# @assert $.is_active false
PATCH /api/v1/users/{{new_user_id}}

{"is_active": false}

### Reactivate user
# @expect 200
# @assert $.is_active true
PATCH /api/v1/users/{{new_user_id}}

{"is_active": true}
