# =============================================================================
# IoTmx API — Public endpoints (no authentication required)
# These work directly in VS Code REST Client / curl / any HTTP tool.
# =============================================================================

@base_url = http://localhost:8000


# ─────────────────────────────────────────────────────────────────────────────
# Ops
# ─────────────────────────────────────────────────────────────────────────────

### Health check
GET {{base_url}}/health

###

### Readiness check
GET {{base_url}}/ready


# ─────────────────────────────────────────────────────────────────────────────
# Auth challenge (public — used as first step of login handshake)
# Response: { "salt": "<32 hex chars>", "message": "..." }
# ─────────────────────────────────────────────────────────────────────────────

### Get password salt for a user
# Replace the email query parameter with the account you want to log in as.
# If the email does not exist the server returns the same structure (user-enum safe).
GET {{base_url}}/api/v1/auth/challenge?email=master_admin@test.com


# ─────────────────────────────────────────────────────────────────────────────
# Onboarding (public — self-service admin registration)
# ─────────────────────────────────────────────────────────────────────────────

### Register a new administrator account
# Returns HTTP 202 — an email verification link is sent to the address.
# All fields are plaintext (no E2E encryption on this endpoint).
POST {{base_url}}/api/v1/onboarding/register
Content-Type: application/json

{
  "first_name": "John",
  "last_name": "Doe",
  "email": "newadmin@example.com",
  "password": "AdminPass123!",
  "phone": "+523312345678"
}

###

### Verify email address (activate account)
# Replace TOKEN with the token from the verification email.
# Returns HTTP 200 on success. Response is the same whether token is valid
# or not (user-enumeration safe).
GET {{base_url}}/api/v1/onboarding/verify?token=REPLACE_WITH_TOKEN_FROM_EMAIL
