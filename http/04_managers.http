# =============================================================================
# IoTmx API — Managers
# Required role: administrator (read/write/delete)
#
# Login first:
#   uv run python http/e2e.py login master_admin@test.com MasterPassword123!
# =============================================================================

@base_url   = http://localhost:8000
@session_id = REPLACE_WITH_SESSION_ID
@manager_id = REPLACE_WITH_MANAGER_UUID


### List all managers
# e2e.py: uv run python http/e2e.py get "/api/v1/managers?offset=0&limit=20"
GET {{base_url}}/api/v1/managers?offset=0&limit=20
X-Session-ID: {{session_id}}

###

### Get manager by ID
# e2e.py: uv run python http/e2e.py get /api/v1/managers/{{manager_id}}
GET {{base_url}}/api/v1/managers/{{manager_id}}
X-Session-ID: {{session_id}}

###

### Create manager
# e2e.py: uv run python http/e2e.py post /api/v1/managers \
#   '{"first_name":"Laura","last_name":"Mendoza","second_last_name":"Vargas","phone":"+523312345700","address":"789 Elm St","city":"Monterrey","state":"Nuevo Leon","postal_code":"64000","birth_date":"1988-11-20","email":"laura@example.com","password":"MgrPass123!","curp":"MEVL881120MNLNRR07","rfc":"MEVL881120AB1"}'
#
# Plaintext body shape:
# {
#   "first_name":       "Laura",
#   "last_name":        "Mendoza",
#   "second_last_name": "Vargas",
#   "phone":            "+523312345700",
#   "address":          "789 Elm St",
#   "city":             "Monterrey",
#   "state":            "Nuevo Leon",
#   "postal_code":      "64000",
#   "birth_date":       "1988-11-20",
#   "email":            "laura@example.com",
#   "password":         "MgrPass123!",
#   "curp":             "MEVL881120MNLNRR07",
#   "rfc":              "MEVL881120AB1"
# }
POST {{base_url}}/api/v1/managers
Content-Type: application/json
X-Session-ID: {{session_id}}

{ "payload": "<encrypted — use e2e.py>", "iv": "<nonce>" }

###

### Update manager (all fields optional)
# e2e.py: uv run python http/e2e.py patch /api/v1/managers/{{manager_id}} \
#   '{"phone":"+523300000010","is_active":true}'
PATCH {{base_url}}/api/v1/managers/{{manager_id}}
Content-Type: application/json
X-Session-ID: {{session_id}}

{ "payload": "<encrypted — use e2e.py>", "iv": "<nonce>" }

###

### Delete manager
# e2e.py: uv run python http/e2e.py delete /api/v1/managers/{{manager_id}}
DELETE {{base_url}}/api/v1/managers/{{manager_id}}
X-Session-ID: {{session_id}}
