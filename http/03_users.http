# =============================================================================
# IoTmx API — Users
# Required role: administrator/manager (read/write), administrator (delete)
#
# Login first:
#   uv run python http/e2e.py login master_admin@test.com MasterPassword123!
# =============================================================================

@base_url  = http://localhost:8000
@session_id = REPLACE_WITH_SESSION_ID
@user_id    = REPLACE_WITH_USER_UUID
@role_id    = REPLACE_WITH_ROLE_UUID


### List all users
# e2e.py: uv run python http/e2e.py get "/api/v1/users?offset=0&limit=20"
GET {{base_url}}/api/v1/users?offset=0&limit=20
X-Session-ID: {{session_id}}

###

### Get user by ID
# e2e.py: uv run python http/e2e.py get /api/v1/users/{{user_id}}
GET {{base_url}}/api/v1/users/{{user_id}}
X-Session-ID: {{session_id}}

###

### Create user
# e2e.py: uv run python http/e2e.py post /api/v1/users \
#   '{"first_name":"Carlos","last_name":"Gutierrez","second_last_name":"Ramos","phone":"+523312345699","address":"456 Oak Ave","city":"Guadalajara","state":"Jalisco","postal_code":"44100","birth_date":"1995-03-10","email":"carlos@example.com","password":"UserPass123!","curp":"GURC950310HJCTML09","rfc":"GURC950310AB1"}'
#
# Plaintext body shape (same fields as administrators):
# {
#   "first_name":       "Carlos",
#   "last_name":        "Gutierrez",
#   "second_last_name": "Ramos",
#   "phone":            "+523312345699",
#   "address":          "456 Oak Ave",
#   "city":             "Guadalajara",
#   "state":            "Jalisco",
#   "postal_code":      "44100",
#   "birth_date":       "1995-03-10",
#   "email":            "carlos@example.com",
#   "password":         "UserPass123!",
#   "curp":             "GURC950310HJCTML09",
#   "rfc":              "GURC950310AB1"
# }
POST {{base_url}}/api/v1/users
Content-Type: application/json
X-Session-ID: {{session_id}}

{ "payload": "<encrypted — use e2e.py>", "iv": "<nonce>" }

###

### Update user (all fields optional)
# e2e.py: uv run python http/e2e.py patch /api/v1/users/{{user_id}} \
#   '{"phone":"+523300000099","is_active":true}'
PATCH {{base_url}}/api/v1/users/{{user_id}}
Content-Type: application/json
X-Session-ID: {{session_id}}

{ "payload": "<encrypted — use e2e.py>", "iv": "<nonce>" }

###

### Delete user
# e2e.py: uv run python http/e2e.py delete /api/v1/users/{{user_id}}
DELETE {{base_url}}/api/v1/users/{{user_id}}
X-Session-ID: {{session_id}}


# ─────────────────────────────────────────────────────────────────────────────
# Role assignments
# ─────────────────────────────────────────────────────────────────────────────

### List roles assigned to a user
# e2e.py: uv run python http/e2e.py get /api/v1/users/{{user_id}}/roles
GET {{base_url}}/api/v1/users/{{user_id}}/roles
X-Session-ID: {{session_id}}

###

### Assign a role to a user
# e2e.py: uv run python http/e2e.py post /api/v1/users/{{user_id}}/roles/{{role_id}} '{}'
POST {{base_url}}/api/v1/users/{{user_id}}/roles/{{role_id}}
Content-Type: application/json
X-Session-ID: {{session_id}}

{ "payload": "<encrypted — use e2e.py>", "iv": "<nonce>" }

###

### Remove a role from a user
# e2e.py: uv run python http/e2e.py delete /api/v1/users/{{user_id}}/roles/{{role_id}}
DELETE {{base_url}}/api/v1/users/{{user_id}}/roles/{{role_id}}
X-Session-ID: {{session_id}}
